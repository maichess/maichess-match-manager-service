{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "MongoDB": "override via env: ConnectionStrings__MongoDB"
  },
  "Jwt": {
    "Key": "override via env: Jwt__Key"
  },
  "Services": {
    "UserService": "override via env: Services__UserService",
    "MoveValidatorService": "override via env: Services__MoveValidatorService",
    "EngineService": "override via env: Services__EngineService"
  }
}
