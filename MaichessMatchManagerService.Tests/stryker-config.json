{
  "stryker-config": {
    "project": "MaichessMatchManagerService.csproj",
    "solution": "../maichess-match-manager-service.sln",
    "test-projects": [
      "MaichessMatchManagerService.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "html"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "!**/Program.cs",
      "!**/*.g.cs",
      "!**/*.generated.cs",
      "!**/Rest/**/*Endpoints.cs",
      "!**/Data/MatchRepository.cs",
      "!**/Data/RedisMatchCache.cs",
      "!**/Data/RedisUserReplica.cs",
      "!**/Data/RedisLiveMatchState.cs",
      "!**/Data/RedisLeaderboard.cs",
      "!**/Kafka/UserReplicaConsumer.cs",
      "!**/Kafka/CheatFlagConsumer.cs",
      "!**/Events/MatchEventProjectorConsumer.cs",
      "!**/Events/KafkaMatchEventProducer.cs",
      "!**/Services/*Exception.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.Write*"
    ]
  }
}
